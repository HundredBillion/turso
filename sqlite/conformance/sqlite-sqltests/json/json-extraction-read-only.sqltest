@database :memory:

test extraction_does_not_create_missing_containers {
    SELECT json_extract(jsonb('{"kept":42}'), '$.missing.child') IS NULL,
           json_extract(jsonb('{"kept":42}'), '$.missing[0].child') IS NULL,
           json_extract(jsonb('{"items":[]}'), '$.items[0].child') IS NULL,
           json_extract(jsonb('{"items":[]}'), '$.items[#].child') IS NULL;
}
expect {
    1|1|1|1
}

test extraction_repeated_paths_keep_original_document {
    SELECT json_extract(jsonb('{"items":[1,null,{"a.b":"v"}],"kept":42}'),
           '$.missing.child', '$.kept', '$.items[#-1]."a.b"', '$.items[1]',
           '$.missing.child', '$.kept');
}
expect {
    [null,42,"v",null,null,42]
}

test extraction_arrows_and_array_length_keep_missing_paths_null {
    SELECT jsonb('{"items":[1,2]}') -> '$.missing.child' IS NULL,
           jsonb('{"items":[1,2]}') ->> '$.missing.child' IS NULL,
           json_array_length(jsonb('{"items":[1,2]}'), '$.missing.child') IS NULL,
           json_array_length(jsonb('{"items":[1,2]}'), '$.items');
}
expect {
    1|1|1|2
}

test extraction_table_functions_keep_missing_paths_empty {
    SELECT (SELECT count(*) FROM json_each(jsonb('{"kept":42}'), '$.missing.child')),
           (SELECT count(*) FROM json_tree(jsonb('{"kept":42}'), '$.missing[0].child'));
}
expect {
    0|0
}

test extraction_preserves_numeric_string_and_root_types {
    SELECT typeof(json_extract(jsonb('{"n":42,"s":"42"}'), '$.n')),
           typeof(json_extract(jsonb('{"n":42,"s":"42"}'), '$.s')),
           json(jsonb_extract(jsonb('{"n":42}'), '$'));
}
expect {
    integer|text|{"n":42}
}

test extraction_preserves_escaped_labels_and_duplicate_key_selection {
    SELECT json_extract(jsonb('{"\u0062":1,"b":2}'), '$.b'),
           json_extract(jsonb('{"a\\b":3}'), '$."a\\b"'),
           json_extract(jsonb('{"a\"b":4}'), '$."a\"b"');
}
expect {
    1|3|4
}
